# Makefile — rendered by dialed:setup. Uses shell commands from .dialed.yml.
#
# Primary contract: the `wait-ready` target is called by every deploy
# workflow between `terraform apply` and system tests. Customize freely —
# DIALED only requires that it blocks until the stack at $STACK_URL is
# serving traffic and exits 0 on success.

SHELL := /usr/bin/env bash

.PHONY: help build test-unit test-integration test-system test-smoke wait-ready tf-plan tf-apply tf-destroy

help:
	@echo "Project targets (generated by DIALED):"
	@echo "  make build             $(value DIALED_BUILD_HINT)"
	@echo "  make test-unit"
	@echo "  make test-integration"
	@echo "  make test-system       STACK_URL=<url>"
	@echo "  make test-smoke        STACK_URL=<url>"
	@echo "  make wait-ready        STACK_URL=<url>"
	@echo ""
	@echo "Terraform convenience (operate on terraform/stack in current workspace):"
	@echo "  make tf-plan"
	@echo "  make tf-apply"
	@echo "  make tf-destroy"

# ─── Commands from .dialed.yml ─────────────────────────────────────────────
# Rendered once at setup. Re-run dialed:setup to re-render after edits.
#
# Each command is rendered as a single-quoted, Make-escaped literal, so a
# command may safely contain quotes and shell vars — e.g.
# test_smoke: 'curl -fsS "$STACK_URL/health"'. Runtime vars (STACK_URL etc.)
# expand at `eval` time.
#
# NOTE: do NOT set a .dialed.yml command to `make <name>` where <name> is one
# of these generated targets (build, test-unit, test-integration, test-system,
# test-smoke) — the target would invoke itself and recurse forever. Point the
# command at the real underlying command (e.g. `go test ./...`) or a
# differently-named target.

build:
	@cmd={{BUILD_CMD_MK}}; \
	if [ -n "$$cmd" ]; then eval "$$cmd"; else echo "(no build command configured in .dialed.yml)"; fi

test-unit:
	@cmd={{TEST_UNIT_CMD_MK}}; \
	if [ -n "$$cmd" ]; then eval "$$cmd"; else echo "(no test_unit command configured)"; fi

test-integration:
	@cmd={{TEST_INTEGRATION_CMD_MK}}; \
	if [ -n "$$cmd" ]; then eval "$$cmd"; else echo "(no test_integration command configured)"; fi

test-system:
	@cmd={{TEST_SYSTEM_CMD_MK}}; \
	if [ -n "$$cmd" ]; then eval "$$cmd"; else echo "(no test_system command configured)"; fi

test-smoke:
	@cmd={{TEST_SMOKE_CMD_MK}}; \
	if [ -n "$$cmd" ]; then eval "$$cmd"; else echo "(no test_smoke command configured)"; fi

# ─── Readiness probe ───────────────────────────────────────────────────────
# Default: poll $STACK_URL every 5s up to 3 minutes; treat any 2xx/3xx as
# ready. Override freely — e.g. for non-HTTP stacks, replace with a check
# that makes sense (SQS queue ready, ECS service steady, etc.).

wait-ready:
	@if [ -z "$$STACK_URL" ]; then \
		echo "STACK_URL is empty — nothing to wait for"; \
		exit 0; \
	fi; \
	echo "Waiting for $$STACK_URL to be ready..."; \
	attempts=0; max_attempts=36; delay=5; \
	while [ $$attempts -lt $$max_attempts ]; do \
		status=$$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "$$STACK_URL" || echo "000"); \
		if [ "$$status" -ge 200 ] 2>/dev/null && [ "$$status" -lt 400 ] 2>/dev/null; then \
			echo "Ready (HTTP $$status) after $$((attempts * delay))s"; \
			exit 0; \
		fi; \
		attempts=$$((attempts + 1)); \
		sleep $$delay; \
	done; \
	echo "::error::$$STACK_URL still not ready after $$((max_attempts * delay))s (last status: $$status)"; \
	exit 1

# ─── Terraform convenience ─────────────────────────────────────────────────

tf-plan:
	cd terraform/stack && terraform plan

tf-apply:
	cd terraform/stack && terraform apply

tf-destroy:
	cd terraform/stack && terraform destroy
